{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "deny": [
            "Read(**/.env)",
            "Read(**/.env.local)",
            "Read(**/.env.*.local)",
            "Read(**/.env.sandbox)",
            "Read(**/.env.prod)",
            "Read(**/.env.production)",
            "Read(**/*.ops-prod.env)",
            "Bash(git stash)",
            "Bash(git stash push:*)",
            "Bash(git stash pop:*)",
            "Bash(git stash apply:*)",
            "Bash(git stash drop:*)",
            "Bash(git stash clear:*)",
            "Bash(git stash -u:*)",
            "Bash(git stash --include-untracked:*)",
            "Bash(git reset --hard:*)",
            "Bash(git clean:*)",
            "Bash(git restore .:*)",
            "Bash(git checkout -- .:*)",
            "Bash(git push --force:*)",
            "Bash(git push -f:*)"
        ]
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/typecheck-before-push.mjs\"",
                        "timeout": 600
                    }
                ]
            }
        ]
    }
}
