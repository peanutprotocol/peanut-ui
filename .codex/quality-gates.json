                "src/context/authContext.tsx",
                "src/hooks/useNotifications.ts",
                "src/services/onesignal/identity.ts",
                "src/services/onesignal/identity-cross-tab-login.test.ts",
                "src/context/__tests__/authContext-push-identity.test.tsx",
                "src/context/__tests__/authContext-logout.test.tsx",
                "src/context/__tests__/authContext-fetchUser.test.tsx",
                "src/context/__tests__/authContext-cross-tab-login.test.tsx",
                "src/context/__tests__/authContext-cross-tab-hook-race.test.tsx",
