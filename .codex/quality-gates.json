{
    "schema_version": 1,
    "timeout_seconds": 420,
    "checks": [
        {
            "name": "tests",
            "argv": [
                "node",
                "--test",
                "scripts/screens/catalogue.test.mjs",
                "scripts/screens/state-coverage.test.mjs",
                "scripts/screens/viewer.test.mjs",
                "scripts/screens/zero-difference-gate-properties.test.mjs",
                "scripts/screens/zero-difference-gate.test.mjs"
            ],
            "cwd": "."
