        {
            "name": "format",
            "argv": [
                "node_modules/.bin/prettier",
                "--check",
                ".codex/quality-gates.json",
                "src/dev/screens/catalogue.ts",
                "src/dev/screens/pages.ts",
                "scripts/screens/capture.ts",
                "scripts/screens/core.mjs",
                "scripts/screens/zero-difference-gate.mjs",
                "public/screen-library/viewer.js",
