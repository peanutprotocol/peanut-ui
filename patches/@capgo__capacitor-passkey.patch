diff --git a/android/src/main/java/app/capgo/passkey/RequestCoordinator.java b/android/src/main/java/app/capgo/passkey/RequestCoordinator.java
new file mode 100644
index 0000000000000000000000000000000000000000..4c78e9bcb79905d5c5e68a2b83895487996e9e46
--- /dev/null
+++ b/android/src/main/java/app/capgo/passkey/RequestCoordinator.java
@@ -0,0 +1,95 @@
+package app.capgo.passkey;
+
+import java.util.function.LongSupplier;
+
+/** One Credential Manager operation. All callers must use the Android main thread. */
+final class RequestCoordinator<T> {
+    static final class Attempt<T> {
+        final String id;
+        final T value;
+        final Runnable signalCancellation;
+        boolean cancelled;
+        boolean completed;
+        long cancelledAt;
+
+        Attempt(String id, T value, Runnable signalCancellation) {
+            this.id = id;
+            this.value = value;
+            this.signalCancellation = signalCancellation;
+        }
+    }
+
+    private final LongSupplier clock;
+    private Attempt<T> active;
+    private int releasedOnCancel;
+    private int lateCallbacks;
+    private long lastLateCallbackMs = -1;
+
+    RequestCoordinator() {
+        this(System::currentTimeMillis);
+    }
+
+    RequestCoordinator(LongSupplier clock) {
+        this.clock = clock;
+    }
+
+    Attempt<T> begin(String id, T value, Runnable signalCancellation) {
+        if (id != null && !validId(id)) throw new IllegalArgumentException("Invalid requestId.");
+        if (active != null) throw new IllegalStateException("A passkey request is already pending.");
+        active = new Attempt<>(id, value, signalCancellation);
+        return active;
+    }
+
+    static boolean validId(String id) {
+        return id != null && id.matches("[A-Za-z0-9_-]{1,64}");
+    }
+
+    /**
+     * Releases the slot at once and returns the released attempt, or null when id is not the live request.
+     * Androidx Play Services (Android 13 and older) never calls back after the CancellationSignal fires, and
+     * the framework can take minutes, so waiting for the provider would block every later request. The
+     * released attempt's later callback is ignored by complete(). Mark and release before signalling:
+     * a provider may call back synchronously from cancel().
+     */
+    Attempt<T> cancel(String id) {
+        Attempt<T> request = active;
+        if (request == null || id == null || !id.equals(request.id)) return null;
+        request.cancelled = true;
+        request.cancelledAt = clock.getAsLong();
+        active = null;
+        releasedOnCancel = Math.min(releasedOnCancel + 1, 10_000);
+        try {
+            request.signalCancellation.run();
+        } catch (RuntimeException ignored) {
+            // The slot is already free; the provider's own callback, if any, is ignored.
+        }
+        return request;
+    }
+
+    /** True only for the live attempt's first terminal callback; that callback may then answer JS. */
+    boolean complete(Attempt<T> request) {
+        if (request.completed) return false;
+        request.completed = true;
+        if (active != request) {
+            if (request.cancelled) {
+                lateCallbacks = Math.min(lateCallbacks + 1, 10_000);
+                lastLateCallbackMs = Math.max(0, clock.getAsLong() - request.cancelledAt);
+            }
+            return false;
+        }
+        active = null;
+        return true;
+    }
+
+    int releasedOnCancel() {
+        return releasedOnCancel;
+    }
+
+    int lateCallbacks() {
+        return lateCallbacks;
+    }
+
+    long lastLateCallbackMs() {
+        return lastLateCallbackMs;
+    }
+}
