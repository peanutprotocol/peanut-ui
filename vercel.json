{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "rewrites": [
        {
            "source": "/",
            "has": [
                {
                    "type": "host",
                    "value": "app.acme.com"
                }
            ],
            "destination": "/app"
        }
    ],
    "functions": {
        "app/api/**/*": {
            "maxDuration": 300
        }
    },
    "routes": [
        {
            "src": "^/.*$",
            "caseSensitive": true,
            "transforms": [
                {
                    "type": "request.headers",
                    "op": "delete",
                    "target": {
                        "key": "x-peanut-split-raw-route"
                    }
                }
            ],
            "continue": true
        },
        {
            "src": "^/(?:(?:en|es-419|pt-br)/split/guides/(?:split-a-group-trip-across-countries|split-expenses-across-currencies)|split-static/(?!(?:\\.{1,2})(?:/|$))[^/%\\\\]+(?:/(?!(?:\\.{1,2})(?:/|$))[^/%\\\\]+)*|split-sitemap\\.xml)$",
            "caseSensitive": true,
            "transforms": [
                {
                    "type": "request.headers",
                    "op": "append",
                    "target": {
                        "key": "x-peanut-split-raw-route"
                    },
                    "args": "canonical-v1"
                },
                {
                    "type": "response.headers",
                    "op": "delete",
                    "target": {
                        "key": "set-cookie"
                    }
                }
            ],
            "continue": true
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "SAMEORIGIN"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "Strict-Transport-Security",
                    "value": "max-age=31536000; includeSubDomains"
                },
                {
                    "key": "Content-Security-Policy",
                    "value": "frame-ancestors 'self'; object-src 'none'; base-uri 'self'"
                }
            ]
        }
    ]
}
