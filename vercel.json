{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "rewrites": [
        {
            "source": "/",
            "has": [
                {
                    "type": "host",
                    "value": "app.acme.com"
                }
            ],
            "destination": "/app"
        }
    ],
    "functions": {
        "app/api/**/*": {
            "maxDuration": 300
        }
    },
    "routes": [
        {
            "src": "^/.*$",
            "caseSensitive": true,
            "transforms": [
                {
                    "type": "request.headers",
                    "op": "delete",
                    "target": {
                        "key": "x-peanut-split-raw-route"
                    }
                },
                {
                    "type": "request.headers",
                    "op": "delete",
                    "target": {
                        "key": "x-peanut-split-raw-unsafe"
                    }
                }
            ],
            "continue": true
        },
        {
            "src": "^(?=/)(?=.*(?:\\\\|%(?:25)*5[cC]|(?:/|%(?:25)*2[fF])(?:\\.|%(?:25)*2[eE]){1,2}(?=/|\\\\|%(?:25)*(?:2[fF]|5[cC])|$))).*$",
            "caseSensitive": true,
            "transforms": [
                {
                    "type": "request.headers",
                    "op": "append",
                    "target": {
                        "key": "x-peanut-split-raw-unsafe"
                    },
                    "args": "unsafe-v1"
                }
            ],
            "continue": true
        },
        {
            "src": "^/(?:(?!(?:api|app|c|claim|dev|faq|history|home|kyc|link|lp|p|pay-with|pay|profile|qr|raffle|request|sdk|send|settings|setup|share)/)(?:[a-z]{2,3}(?:-[a-z]{4})?(?:-(?:[a-z]{2}|[0-9]{3}))?)/split(?:/(?:guides/[a-z0-9]+(?:-[a-z0-9]+)*|alternatives/[a-z0-9]+(?:-[a-z0-9]+)*|tools(?:/[a-z0-9]+(?:-[a-z0-9]+)*)?))?|split-static/(?!(?:\\.{1,2})(?:/|$))(?:[^/%\\\\]|%5[bBdD])+(?:/(?!(?:\\.{1,2})(?:/|$))(?:[^/%\\\\]|%5[bBdD])+)*|split-sitemap\\.xml)$",
            "caseSensitive": true,
            "transforms": [
                {
                    "type": "request.headers",
                    "op": "append",
                    "target": {
                        "key": "x-peanut-split-raw-route"
                    },
                    "args": "canonical-v1"
                },
                {
                    "type": "response.headers",
                    "op": "delete",
                    "target": {
                        "key": "set-cookie"
                    }
                }
            ],
            "continue": true
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "SAMEORIGIN"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "Strict-Transport-Security",
                    "value": "max-age=31536000; includeSubDomains"
                },
                {
                    "key": "Content-Security-Policy",
                    "value": "frame-ancestors 'self'; object-src 'none'; base-uri 'self'"
                }
            ]
        }
    ]
}
